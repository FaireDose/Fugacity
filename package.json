{
  "name": "chepta",
  "version": "0.3.0",
  "description": "Chemical process simulation built for AI chat artifacts, starting with phase equilibria.",
  "license": "MIT",
  "author": "FaireDose",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaireDose/CHEPTA.git"
  },
  "homepage": "https://github.com/FaireDose/CHEPTA#readme",
  "keywords": [
    "chemical-engineering",
    "thermodynamics",
    "vapor-liquid-equilibrium",
    "NRTL",
    "UNIQUAC",
    "residue-curves",
    "process-simulation",
    "flowsheet"
  ],
  "type": "module",
  "main": "dist/chepta.cjs",
  "module": "dist/chepta.mjs",
  "browser": "dist/chepta.js",
  "unpkg": "dist/chepta.js",
  "jsdelivr": "dist/chepta.js",
  "exports": {
    ".": {
      "import": "./dist/chepta.mjs",
      "require": "./dist/chepta.cjs"
    },
    "./browser": "./dist/chepta.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "wanted": "node scripts/data-wanted.mjs",
    "check-package": "node scripts/check-package.mjs",
    "report": "node scripts/engineering-report.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
