    "access": "Free to read online (NIST); an allowed source under AGENTS.md rule 1",
    "tables": "Constant pressure heat capacity of liquid (Mask=2); Enthalpy of vaporization (Mask=4)"
  },
  "rules": {
    "liquidHeatCapacity": "The record at 298.15 K is compared with the mean of the WebBook values measured in 1970 or later at 298.15 ± 0.5 K. Older values and values at other temperatures are not listed.",
